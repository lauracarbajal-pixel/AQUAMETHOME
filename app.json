{
  "expo": {
    "name": "AQUAMET",
    "slug": "aquamet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquamet.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EBF5FF"
      },
      "package": "com.aquamet.app",
      "permissions": [
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
